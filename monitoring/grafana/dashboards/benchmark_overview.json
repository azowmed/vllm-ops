{
  "title": "Benchmark overview",
  "uid": "bench-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "",
  "tags": ["vllm", "benchmark"],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests waiting (queue)",
      "description": "vllm:num_requests_waiting - requests queued because no slot/KV is free.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "vllm:num_requests_waiting", "legendFormat": "waiting" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "vllm:num_requests_running", "legendFormat": "running" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "KV cache usage",
      "description": "vllm:kv_cache_usage_perc - 1.0 means the KV cache is full (expect preemptions near the top).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 20 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "vllm:kv_cache_usage_perc", "legendFormat": "kv usage" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Preemptions (rate)",
      "description": "rate(vllm:num_preemptions_total[1m]) - sequences evicted from the batch when the KV cache is exhausted.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(vllm:num_preemptions_total[1m])", "legendFormat": "preemptions/s" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Generation throughput (tok/s)",
      "description": "rate(vllm:generation_tokens_total[1m]) - output tokens produced per second across all requests.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(vllm:generation_tokens_total[1m])", "legendFormat": "gen tok/s" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "TTFT p95 (s)",
      "description": "histogram_quantile(0.95, rate(vllm:time_to_first_token_seconds_bucket[1m])) - prefill/queueing latency grows with concurrency.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[1m])))",
          "legendFormat": "ttft p95" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Inter-token latency p95 (s)",
      "description": "histogram_quantile(0.95, rate(vllm:inter_token_latency_seconds_bucket[1m])) - decode step latency.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket[1m])))",
          "legendFormat": "itl p95" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DRAM active (DCGM)",
      "description": "DCGM_FI_PROF_DRAM_ACTIVE - memory-bandwidth-bound work; high during decode.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 20 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "DCGM_FI_PROF_DRAM_ACTIVE", "legendFormat": "GPU {{gpu}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tensor-core active (DCGM)",
      "description": "DCGM_FI_PROF_PIPE_TENSOR_ACTIVE - compute-bound work; high during prefill.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 20 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "DCGM_FI_PROF_PIPE_TENSOR_ACTIVE", "legendFormat": "GPU {{gpu}}" }
      ]
    }
  ]
}
