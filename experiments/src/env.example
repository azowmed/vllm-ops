# Copy to .env and adjust. .env is git-ignored and must never be committed.
#   cp experiments/src/env.example .env      # .env lives at the REPO ROOT
#
# NOTE: this template is named `env.example` (not `.env.example`) only because
# the dev sandbox blocks writing dot-env files; rename it if you prefer.
#
# The two parts of this project are decoupled:
#   - The vLLM part (serve / bench / monitoring) needs NONE of the Bedrock vars.
#   - The Bedrock part needs only OPENAI_API_KEY (+ network). No AWS creds ever
#     touch the GPU instance.

# ----------------------------------------------------------------------------
# Run identity: outputs go to experiments/<GPU>/<RUN>/raw (one folder per run)
# ----------------------------------------------------------------------------
GPU=h100                    # h100 | l40s | ...  (the instance-type folder)
RUN=2026-10-20_bf16-kv      # <date>_<what changed>; new name for every run

# ----------------------------------------------------------------------------
# vLLM server + image  (pin the version you actually ran)
# ----------------------------------------------------------------------------
# All CLI flags in experiments/src/scripts/ were checked against the vLLM v0.27.0 docs. If you
# bump this tag, re-run experiments/src/scripts/00_check_instance.sh and re-check metric names
# (see experiments/src/README.md "Checking vLLM metric names").
VLLM_IMAGE=vllm/vllm-openai:v0.27.0
MODEL=Qwen/Qwen3-32B-FP8
SERVED_MODEL_NAME=Qwen/Qwen3-32B-FP8
MAX_MODEL_LEN=8192
GPU_MEM_UTIL=0.90
# KV-cache dtype. Default run uses 'auto' (BF16 KV). On the L40S (Ada) set this to
# 'fp8' to ~double the KV-cache capacity (see findings/predictions.md).
KV_CACHE_DTYPE=auto
VLLM_PORT=8000
# Extra flags appended verbatim to `vllm serve` (e.g. "--max-num-seqs 128").
VLLM_EXTRA_ARGS=
# Only needed for gated models; Qwen3-32B-FP8 is public, leave empty.
HF_TOKEN=
# Where the HuggingFace cache is persisted on the host (speeds up restarts).
HF_CACHE=$HOME/.cache/huggingface

# ----------------------------------------------------------------------------
# Benchmark workload (identical for both targets)
# ----------------------------------------------------------------------------
TARGET=vllm                 # vllm | bedrock
CONCURRENCIES="1 8 16 32 64"   # quote: .env is sourced, spaces would be split
INPUT_LEN=1024
OUTPUT_LEN=256
SEED=42
PERCENTILES=50,95,99        # --metric-percentiles passed to `vllm bench serve`

# ----------------------------------------------------------------------------
# Bedrock target (OpenAI-compatible "mantle" gateway) -- optional
# ----------------------------------------------------------------------------
# Generate the token LOCALLY (never on the instance):
#   export OPENAI_API_KEY=$(python experiments/src/scripts/make_bedrock_token.py)
OPENAI_API_KEY=
BEDROCK_BASE_URL=https://bedrock-mantle.eu-north-1.api.aws
BEDROCK_MODEL=qwen.qwen3-32b
BEDROCK_ENDPOINT=/v1/chat/completions
# The Bedrock model name differs from the local one, so the client tokenizer is
# pinned explicitly to the matching HuggingFace tokenizer.
BEDROCK_TOKENIZER=Qwen/Qwen3-32B
AWS_REGION=eu-north-1

# ----------------------------------------------------------------------------
# Cloud metadata (used in run metadata; optional, overrides auto-detection)
# ----------------------------------------------------------------------------
CLOUD_PROVIDER=scaleway
CLOUD_ZONE=
